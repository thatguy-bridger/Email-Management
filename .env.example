# Postgres connection string. If you provision Storage > Postgres in the
# Vercel dashboard and connect it to this project, Vercel injects
# POSTGRES_URL automatically and you can leave DATABASE_URL unset.
DATABASE_URL=postgres://user:password@host:5432/dbname

# 32 raw bytes for AES-256-GCM, as a 64-char hex string.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Signs session cookies (login state). A different 64-char hex string from
# ENCRYPTION_KEY -- don't reuse one secret for two purposes.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: protects /api/cron/sync from being triggered by anyone who finds
# the URL. Vercel automatically sends this as a Bearer token when it invokes
# the cron job, once the same value is set as a project env var.
CRON_SECRET=
